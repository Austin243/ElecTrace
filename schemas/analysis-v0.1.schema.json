{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Austin243/ElecTrace/schemas/analysis-v0.1.schema.json",
  "title": "ElecTrace analysis",
  "type": "object",
  "required": ["schema_version", "project", "frames", "transitions", "events", "tracks"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "software_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "project": {"type": "object", "additionalProperties": true},
    "configuration": {"type": "object", "additionalProperties": true},
    "provenance": {"type": "object", "additionalProperties": true},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "frames": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "transitions": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "type",
          "start_frame",
          "confidence",
          "confidence_label",
          "persistence",
          "persistence_status",
          "persistent"
        ],
        "properties": {
          "event_id": {"type": "string"},
          "type": {"type": "string"},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": ["integer", "null"], "minimum": 0},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "target_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence_label": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Deterministic configured-threshold label; not a calibrated probability."
          },
          "persistence": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of observable frames supporting the event state."
          },
          "persistence_status": {
            "type": "string",
            "enum": ["transient", "confirmed", "right_censored", "unknown"],
            "description": "Deterministic persistence classification under configured settings."
          },
          "persistent": {
            "type": "boolean",
            "description": "True only when persistence_status is confirmed."
          },
          "description": {"type": "string"},
          "barrier_position": {
            "enum": ["before", "spanning", "after", null],
            "description": "Event step relative to the highest-energy frame(s): spanning when the step starts or ends at one; null when events are not placed."
          },
          "noise_floor": {
            "type": "object",
            "description": "Present only when a focus holds atoms, on a reported property change of an atom-charge feature whose producer, element, and a flagged quantity have a noise_floor entry. Reporting only.",
            "required": ["element", "producer", "changes"],
            "properties": {
              "element": {"type": "string"},
              "producer": {"type": ["string", "null"]},
              "changes": {
                "type": "object",
                "description": "Keyed by each flagged quantity (charge, volume, or spin).",
                "propertyNames": {"enum": ["charge", "volume", "spin"]},
                "additionalProperties": {
                  "type": "object",
                  "required": ["delta", "ratio_to_floor"],
                  "properties": {
                    "delta": {
                      "type": "number",
                      "description": "Target minus source value in native units; absolute even for volume events, which are flagged by relative change."
                    },
                    "ratio_to_floor": {
                      "type": "object",
                      "description": "abs(delta) divided by each floor percentile; null where that percentile is zero.",
                      "required": ["median", "p95", "p99"],
                      "properties": {
                        "median": {"$ref": "#/$defs/floor_ratio"},
                        "p95": {"$ref": "#/$defs/floor_ratio"},
                        "p99": {"$ref": "#/$defs/floor_ratio"}
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "tracks": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "track_summary": {
      "type": "array",
      "description": "One whole-path record per feature track. Reporting only: no thresholds or events.",
      "items": {
        "type": "object",
        "required": [
          "track_id",
          "kind",
          "first_frame",
          "last_frame",
          "observations",
          "spans_path",
          "parent_track_ids",
          "changes"
        ],
        "properties": {
          "track_id": {"type": "string"},
          "kind": {"type": "string"},
          "first_frame": {"type": "integer", "minimum": 0},
          "last_frame": {"type": "integer", "minimum": 0},
          "observations": {"type": "integer", "minimum": 1},
          "spans_path": {
            "type": "boolean",
            "description": "True when the track is observed in the first and last frames of the path."
          },
          "parent_track_ids": {"type": "array", "items": {"type": "string"}},
          "changes": {
            "type": "object",
            "description": "Keyed by charge, volume, and each configured descriptor (such as icohp or spin), in native units.",
            "additionalProperties": {
              "type": "object",
              "required": ["observed", "net_change", "range", "largest_step"],
              "properties": {
                "observed": {"type": "integer", "minimum": 0},
                "net_change": {
                  "type": ["number", "null"],
                  "description": "Last-frame minus first-frame value; null unless both exist."
                },
                "range": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "description": "Maximum minus minimum over frames with a value; null for fewer than two."
                },
                "largest_step": {
                  "type": ["object", "null"],
                  "description": "Adjacent-frame change with the largest magnitude; earliest on ties.",
                  "required": ["frame_before", "frame_after", "delta"],
                  "properties": {
                    "frame_before": {"type": "integer", "minimum": 0},
                    "frame_after": {"type": "integer", "minimum": 0},
                    "delta": {"type": "number"}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "barrier": {
      "type": "object",
      "description": "Highest-energy frame(s) used to place events. Reporting only: no tolerance or thresholds.",
      "required": ["frames"],
      "properties": {
        "frames": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "description": "Frame indices at the maximum energy; several only on exact ties; empty when events are not placed."
        },
        "rise_from_first": {"type": "number", "minimum": 0},
        "rise_from_last": {"type": "number", "minimum": 0},
        "reason": {"type": "string", "description": "Why events are not placed."}
      },
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "description": "Present only with outputs.focus_atoms. Events, tracks, and track_summary then cover the tracks tied to these atoms; with focus_atoms = \"auto\" and no atom selected, they cover everything.",
      "required": ["atoms", "tracks", "observations", "events"],
      "properties": {
        "atoms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "element"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "element": {"type": "string"},
              "rules": {
                "type": "array",
                "description": "With focus_atoms = \"auto\": the rules that selected the atom.",
                "items": {"enum": ["bond", "spin", "bcp"]},
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "tracks": {"$ref": "#/$defs/focus_count"},
        "observations": {"$ref": "#/$defs/focus_count"},
        "events": {"$ref": "#/$defs/focus_count"},
        "selection": {"const": "auto", "description": "Present with focus_atoms = \"auto\"."},
        "rules": {
          "type": "object",
          "description": "Present with focus_atoms = \"auto\": each rule's settings, and why a rule did not run.",
          "required": ["bond", "spin", "bcp"],
          "properties": {
            "bond": {
              "type": "object",
              "required": ["applied", "cutoffs", "changed_bonds"],
              "properties": {
                "applied": {"const": true},
                "cutoffs": {
                  "type": "object",
                  "description": "Element-pair cutoffs in angstrom, keyed like \"H-N\".",
                  "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
                },
                "changed_bonds": {
                  "type": "array",
                  "description": "Atom pairs bonded in some frames and not in others.",
                  "items": {
                    "type": "array",
                    "items": {"type": "integer", "minimum": 0},
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              },
              "additionalProperties": false
            },
            "spin": {
              "type": "object",
              "required": ["applied", "threshold"],
              "properties": {
                "applied": {"type": "boolean"},
                "threshold": {"type": ["number", "null"], "exclusiveMinimum": 0},
                "reason": {"type": "string"}
              },
              "additionalProperties": false
            },
            "bcp": {
              "type": "object",
              "required": ["applied", "connectivity_changes"],
              "properties": {
                "applied": {"type": "boolean"},
                "connectivity_changes": {"type": "integer", "minimum": 0},
                "reason": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "noise_floor": {
      "type": "array",
      "description": "Present only when a focus holds atoms: percentiles of the adjacent-frame absolute change of spectator atom-charge features (tracks that never touch a focus atom), per producer, element, and quantity. Reporting only: no thresholds or events.",
      "items": {
        "type": "object",
        "required": ["producer", "element", "quantity", "atoms", "steps", "median", "p95", "p99"],
        "properties": {
          "producer": {"type": ["string", "null"]},
          "element": {"type": "string"},
          "quantity": {"enum": ["charge", "volume", "spin"]},
          "atoms": {"type": "integer", "minimum": 1},
          "steps": {"type": "integer", "minimum": 1},
          "median": {"type": "number", "minimum": 0},
          "p95": {"type": "number", "minimum": 0},
          "p99": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "floor_ratio": {"type": ["number", "null"], "minimum": 0},
    "focus_count": {
      "type": "object",
      "required": ["reported", "total"],
      "properties": {
        "reported": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
