{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Austin243/ElecTrace/schemas/analysis-v0.1.schema.json",
  "title": "ElecTrace analysis",
  "type": "object",
  "required": ["schema_version", "project", "frames", "transitions", "events", "tracks"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "software_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "project": {"type": "object", "additionalProperties": true},
    "configuration": {"type": "object", "additionalProperties": true},
    "provenance": {"type": "object", "additionalProperties": true},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "frames": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "transitions": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "type",
          "start_frame",
          "confidence",
          "confidence_label",
          "persistence",
          "persistence_status",
          "persistent"
        ],
        "properties": {
          "event_id": {"type": "string"},
          "type": {"type": "string"},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": ["integer", "null"], "minimum": 0},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "target_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence_label": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Deterministic configured-threshold label; not a calibrated probability."
          },
          "persistence": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of observable frames supporting the event state."
          },
          "persistence_status": {
            "type": "string",
            "enum": ["transient", "confirmed", "right_censored", "unknown"],
            "description": "Deterministic persistence classification under configured settings."
          },
          "persistent": {
            "type": "boolean",
            "description": "True only when persistence_status is confirmed."
          },
          "description": {"type": "string"},
          "barrier_position": {
            "enum": ["before", "spanning", "after", null],
            "description": "Event step relative to the highest-energy frame(s): spanning when the step starts or ends at one; null when events are not placed."
          }
        },
        "additionalProperties": true
      }
    },
    "tracks": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "track_summary": {
      "type": "array",
      "description": "One whole-path record per feature track. Reporting only: no thresholds or events.",
      "items": {
        "type": "object",
        "required": [
          "track_id",
          "kind",
          "first_frame",
          "last_frame",
          "observations",
          "spans_path",
          "parent_track_ids",
          "changes"
        ],
        "properties": {
          "track_id": {"type": "string"},
          "kind": {"type": "string"},
          "first_frame": {"type": "integer", "minimum": 0},
          "last_frame": {"type": "integer", "minimum": 0},
          "observations": {"type": "integer", "minimum": 1},
          "spans_path": {
            "type": "boolean",
            "description": "True when the track is observed in the first and last frames of the path."
          },
          "parent_track_ids": {"type": "array", "items": {"type": "string"}},
          "changes": {
            "type": "object",
            "description": "Keyed by charge, volume, net_charge when any frame has net charges, and each configured descriptor (such as icohp or spin), in native units.",
            "additionalProperties": {
              "type": "object",
              "required": ["observed", "net_change", "range", "largest_step"],
              "properties": {
                "observed": {"type": "integer", "minimum": 0},
                "net_change": {
                  "type": ["number", "null"],
                  "description": "Last-frame minus first-frame value; null unless both exist."
                },
                "range": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "description": "Maximum minus minimum over frames with a value; null for fewer than two."
                },
                "largest_step": {
                  "type": ["object", "null"],
                  "description": "Adjacent-frame change with the largest magnitude; earliest on ties.",
                  "required": ["frame_before", "frame_after", "delta"],
                  "properties": {
                    "frame_before": {"type": "integer", "minimum": 0},
                    "frame_after": {"type": "integer", "minimum": 0},
                    "delta": {"type": "number"}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "bonds": {
      "type": "array",
      "description": "One record per atom pair, periodic image, and frame for features tied to exactly two atoms, ordered by bond and frame. Reporting only: no thresholds or events.",
      "items": {
        "type": "object",
        "required": [
          "bond_id",
          "frame",
          "frame_label",
          "atom_a",
          "element_a",
          "atom_b",
          "element_b",
          "lattice_translation",
          "distance",
          "field",
          "laplacian",
          "icohp",
          "icobi",
          "feature_ids",
          "track_ids"
        ],
        "properties": {
          "bond_id": {
            "type": "string",
            "description": "One atom pair and periodic image along the path, followed through atoms that wrap across the cell. A row begins or ends where no feature ties the pair."
          },
          "frame": {"type": "integer", "minimum": 0},
          "frame_label": {"type": "string"},
          "atom_a": {"type": "integer", "minimum": 0, "description": "0-based POSCAR index; atom_a <= atom_b."},
          "element_a": {"type": "string"},
          "atom_b": {"type": "integer", "minimum": 0, "description": "0-based POSCAR index; equal to atom_a for a bond to the atom's own image."},
          "element_b": {"type": "string"},
          "lattice_translation": {
            "type": "array",
            "items": {"type": "integer"},
            "minItems": 3,
            "maxItems": 3,
            "description": "Image of atom_b joined to atom_a in this frame's fractional coordinates: the feature's own translation, else the nearest image."
          },
          "distance": {"type": "number", "minimum": 0, "description": "Interatomic distance in angstrom."},
          "field": {"type": ["number", "null"], "description": "Density at the bond critical point (critic2 units)."},
          "laplacian": {"type": ["number", "null"], "description": "Laplacian at the bond critical point (critic2 units)."},
          "icohp": {"type": ["number", "null"], "description": "LOBSTER ICOHP in eV."},
          "icobi": {"type": ["number", "null"], "description": "LOBSTER ICOBI."},
          "feature_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "track_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "barrier": {
      "type": "object",
      "description": "Highest-energy frame(s) used to place events. Reporting only: no tolerance or thresholds.",
      "required": ["frames"],
      "properties": {
        "frames": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "description": "Frame indices at the maximum energy; several only on exact ties; empty when events are not placed."
        },
        "rise_from_first": {"type": "number", "minimum": 0},
        "rise_from_last": {"type": "number", "minimum": 0},
        "reason": {"type": "string", "description": "Why events are not placed."}
      },
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "description": "Present only with outputs.focus_atoms. Events, tracks, and track_summary then cover the tracks tied to these atoms, and bonds the pairs that include one.",
      "required": ["atoms", "tracks", "observations", "events"],
      "properties": {
        "atoms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "element"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "element": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "tracks": {"$ref": "#/$defs/focus_count"},
        "observations": {"$ref": "#/$defs/focus_count"},
        "events": {"$ref": "#/$defs/focus_count"},
        "bonds": {"$ref": "#/$defs/focus_count"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "focus_count": {
      "type": "object",
      "required": ["reported", "total"],
      "properties": {
        "reported": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
